<Window x:Class="Lab2.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Lab2"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
    <!-- WrapPanel автоматично переносить елементи на наступний рядок,
         коли в поточному рядку не вистачає місця -->
    <WrapPanel Orientation="Horizontal"
               HorizontalAlignment="Center"
               VerticalAlignment="Center"
               Margin="10">

        <!-- Перший "набір" елементів -->
        <Label Content="Label" Margin="10"/>
        <TextBox Text="TextBox" Width="85"/> 
        <TextBox Text="TextBox" Width="85"/>
        <TextBox Text="TextBox" Width="85"/>
        <TextBox Text="TextBox" Width="85"/>
        <TextBox Text="TextBox" Width="85"/>
        <TextBox Text="TextBox" Width="85"/>
        <TextBox Text="TextBox" Width="85"/>
        <TextBox Text="TextBox" Width="85"/>

        <!-- Другий "набір" елементів (почне відображатися праворуч 
             або з нового рядка, якщо бракує місця) -->
        <Label Content="Label" Margin="10"/>
        <TextBox Text="TextBox" Width="85"/>
        <TextBox Text="TextBox" Width="85"/>
        <TextBox Text="TextBox" Width="85"/>
        <TextBox Text="TextBox" Width="85"/>
        <TextBox Text="TextBox" Width="85"/>
        <TextBox Text="TextBox" Width="85"/>
        <TextBox Text="TextBox" Width="85"/>
        <TextBox Text="TextBox" Width="85"/>
        
    </WrapPanel>
    <Button HorizontalAlignment="Center" VerticalAlignment="Center"  Margin="0 200 0 0 " Content="Button" Width="80"/>
    </Grid>
</Window>
