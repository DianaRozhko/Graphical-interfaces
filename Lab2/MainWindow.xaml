<Window x:Class="Lab2.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Lab2"
        mc:Ignorable="d"
        Title="TextEditor" Height="450" Width="600">

    <!-- Головний контейнер -->
    <Grid>
        <Grid.RowDefinitions>
            <!-- Верхній рядок для панелі кнопок -->
            <RowDefinition Height="Auto"/>
            <!-- Нижній рядок для текстової області -->
            <RowDefinition/>
        </Grid.RowDefinitions>
        <!--Верхній Border з заокругленими кутами та кнопками -->
        <Border Grid.Row="0"
                BorderBrush="#FFCBBEBE"
                BorderThickness="2"
                CornerRadius="10"
                Margin="5">
            <StackPanel Orientation="Horizontal">
                <Button ToolTip="Відкрити" >
                    <Image Source="images/open.png" Width="40" Height="40"/>
                </Button>
                <Button ToolTip="Стерти" >
                    <Image Source="images/clean.png" Width="40" Height="40"/>
                </Button>
                <Button ToolTip="Копіювати">
                    <Image Source="images/copy.png" Width="40" Height="40"/>
                </Button>
                <Button ToolTip="Вставити" >
                    <Image Source="images/paste.png" Width="40" Height="40"/>
                </Button>
            </StackPanel>
        </Border>

        <!-- Нижній Border з внутрішнім Grid (2 рядки):
             - Верхній рядок: TextBox (з прокруткою)
             - Нижній рядок (Auto): DockPanel із кнопкою "OK" -->
        <Border Grid.Row="1"
                BorderBrush="#FFCBBEBE"
                BorderThickness="2"
                CornerRadius="10"
                Margin="5">
            <Grid Margin="10">
                <Grid.RowDefinitions>
                    <!-- Перший рядок заповнює доступний простір -->
                    <RowDefinition/>
                    <!-- Другий рядок - автоматична висота -->
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- TextBox з вертикальною прокруткою -->
                <TextBox Grid.Row="0"
                         Margin="5"
                         AcceptsReturn="True"
                         VerticalScrollBarVisibility="Visible"
                         HorizontalScrollBarVisibility="Auto"/>

                <!-- DockPanel із кнопкою, "пристикованою" донизу -->
                <DockPanel Grid.Row="1" LastChildFill="False">
                    <Button Content="OK" DockPanel.Dock="Bottom" Width="30" Margin="5"/>
                </DockPanel>
            </Grid>
        </Border>
    </Grid>
</Window>