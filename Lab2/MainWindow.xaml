<Window x:Class="Lab2.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Lab2"
        mc:Ignorable="d"
        Title="TextEditor" Height="450" Width="600">

    <!-- Оголошення ресурсів вікна -->
    <Window.Resources>
        <!-- Лінійний градієнт: жовтий – блакитний – жовтий -->
        <LinearGradientBrush x:Key="LinearPanelBrush" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="Yellow" Offset="0"/>
            <GradientStop Color="Cyan" Offset="0.5"/>
            <GradientStop Color="Yellow" Offset="1"/>
        </LinearGradientBrush>

        <!-- Стиль за замовчуванням для всіх кнопок (крім тих, у яких він скасований) -->
        <Style TargetType="Button">
            <Setter Property="Padding" Value="5"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="White"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
    </Window.Resources>

    <!-- Головний контейнер -->
    <Grid>
        <Grid.RowDefinitions>
            <!-- Верхній рядок для панелі кнопок -->
            <RowDefinition Height="Auto"/>
            <!-- Нижній рядок для текстової області -->
            <RowDefinition/>
        </Grid.RowDefinitions>

        <!-- Верхній Border з заокругленими кутами, градієнтом і кнопками -->
        <Border Grid.Row="0"
                Background="{StaticResource LinearPanelBrush}"
                BorderBrush="#FFCBBEBE"
                BorderThickness="2"
                CornerRadius="10"
                Margin="5">
            <StackPanel Orientation="Horizontal">
                <!-- Кнопка "Відкрити" -->
                <Button ToolTip="Відкрити"
                        Command="{x:Static ApplicationCommands.Open}">
                    <Image Source="images/open.png" Width="60" Height="60"/>
                </Button>
                <!-- Кнопка "Стерти" (очищення TextBox) -->
                <Button ToolTip="Стерти"
                        Command="{x:Static ApplicationCommands.Close}">
                    <Image Source="images/clean.png" Width="60" Height="60"/>
                </Button>
                <!-- Кнопка "Копіювати" – вбудована команда Copy -->
                <Button ToolTip="Копіювати"
                        Command="Copy"
                        CommandTarget="{Binding ElementName=MainTextBox}">
                    <Image Source="images/copy.png" Width="60" Height="60"/>
                </Button>
                <!-- Кнопка "Вставити" – вбудована команда Paste -->
                <Button ToolTip="Вставити"
                        Command="Paste"
                        CommandTarget="{Binding ElementName=MainTextBox}">
                    <Image Source="images/paste.png" Width="60" Height="60"/>
                </Button>
            </StackPanel>
        </Border>

        <!-- Нижній Border із внутрішнім Grid -->
        <Border Grid.Row="1"
                Background="{StaticResource LinearPanelBrush}"
                BorderBrush="#FFCBBEBE"
                BorderThickness="2"
                CornerRadius="10"
                Margin="5">
            <Grid Margin="10">
                <Grid.RowDefinitions>
                    <!-- Перший рядок: TextBox заповнює весь простір -->
                    <RowDefinition/>
                    <!-- Другий рядок: DockPanel для повзунка та кнопки "OK" -->
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- TextBox із прив'язаним розміром шрифту -->
                <TextBox x:Name="MainTextBox"
                         Grid.Row="0"
                         Margin="5"
                         AcceptsReturn="True"
                         VerticalScrollBarVisibility="Visible"
                         HorizontalScrollBarVisibility="Auto"
                         FontSize="{Binding ElementName=fontSlider, Path=Value}"/>

                <!-- DockPanel, де розташовані Label, Slider і кнопка OK -->
                <DockPanel Grid.Row="1" LastChildFill="False" Margin="5">
                    <Label Content="Розмір шрифту:" 
                           DockPanel.Dock="Left" 
                           VerticalAlignment="Center"
                           Margin="4,0"/>
                    <Slider x:Name="fontSlider"
                            DockPanel.Dock="Left"
                            Margin="4"
                            MinWidth="100"
                            Minimum="12"
                            Maximum="100"
                            Value="24" />
                    <!-- Кнопка "OK" – прив'язана до команди Save; стиль скасовано -->
                    <Button Content="OK"
                            Style="{x:Null}"
                            Command="{x:Static ApplicationCommands.Save}"
                            DockPanel.Dock="Bottom"
                            Width="40"
                            Margin="4"/>
                </DockPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
