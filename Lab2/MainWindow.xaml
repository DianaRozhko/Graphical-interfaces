<Window x:Class="Lab2.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Lab2"
        mc:Ignorable="d"
        Title="MainWindow" Height="300" Width="600">

    <!-- Canvas надає можливість розміщувати елементи у фіксованих координатах -->
    <Canvas Background="Cyan">
        <!-- Label зі зміщенням ліворуч на 20 і згори на 20 -->
        <Label Canvas.Left="20" Canvas.Top="20">Lable</Label>

        <!-- TextBox зі зміщенням ліворуч на 40 і згори на 40 -->
        <TextBox Canvas.Left="40"  Canvas.Top="40" Width="60">TextBox</TextBox>

        <!-- Button зі зміщенням ліворуч на 60 і згори на 60 -->
        <Button Canvas.Left="60" Canvas.Top="60"  Width="60">Button</Button>
    </Canvas>
</Window>
