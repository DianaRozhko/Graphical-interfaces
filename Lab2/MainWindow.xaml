<Window x:Class="Lab2.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Lab2"
        mc:Ignorable="d"
        Title="MainWindow" Height="350" Width="600">
    <DockPanel LastChildFill="False">
        <Label DockPanel.Dock="Top" HorizontalAlignment="Center" Margin="20" >Label </Label>
        <TextBox DockPanel.Dock="Left" Width="220" >TexBox</TextBox>
        <TextBox DockPanel.Dock="Right" Width="220" >TexBox</TextBox>
        <Button DockPanel.Dock="Bottom" Margin="0 0 0 40" Height="30" Width="120" >Button</Button>
    </DockPanel>
</Window>
