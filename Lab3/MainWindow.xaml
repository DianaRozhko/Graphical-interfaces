<Window x:Class="FortuneTeller.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Гра Ворожка" Height="600" Width="550" Background="#FFF3E5F5" MinHeight="350" MinWidth="300"
        SizeToContent="Manual">

    <Window.Resources>
        <Style x:Key="DataGridHeaderStyle" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#BA68C8"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="Height" Value="30"/>
        </Style>
    </Window.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBlock Text="Задай своє питання і натисни кнопку!"
                       FontSize="20" FontWeight="Bold"
                       HorizontalAlignment="Center" Margin="0,10"
                       Foreground="#7B1FA2" TextWrapping="Wrap"/>

            <TextBox x:Name="QuestionTextBox" Grid.Row="1" Margin="0,10" FontSize="16"
                     Padding="5" Background="White" BorderBrush="#AB47BC" BorderThickness="2"
                     Foreground="#4A148C" VerticalContentAlignment="Center"
                     HorizontalAlignment="Stretch"
                     TextChanged="QuestionTextBox_TextChanged"/>

            <Border Grid.Row="2" Background="#E1BEE7" CornerRadius="10" Padding="10" Margin="0,20"
                    VerticalAlignment="Stretch">
                <StackPanel VerticalAlignment="Stretch">
                    <TextBlock Text="Відповідь на ваше питання:"
                               FontSize="16" FontWeight="Bold"
                               Margin="0,0,0,5"
                               Foreground="#4A148C"
                               TextAlignment="Center"/>
                    <TextBlock x:Name="AnswerText" Text="Тут буде відповідь..." 
                               FontSize="22" FontWeight="SemiBold"
                               TextWrapping="Wrap"
                               TextAlignment="Center"
                               Foreground="#4A148C"/>
                </StackPanel>
            </Border>

            <Button x:Name="AskButton"
                    Grid.Row="3"
                    Content="Запитати Ворожку"
                    Click="AskFortune_Click"
                    Background="#BA68C8" Foreground="White" FontSize="16" FontWeight="Bold"
                    Padding="10" Margin="0,10" HorizontalAlignment="Center"
                    Width="200" Height="50" BorderBrush="#6A1B9A" BorderThickness="2"
                    IsEnabled="False"/>

            <DataGrid x:Name="HistoryGrid"
                      Grid.Row="4"
                      Margin="0,20,0,0"
                      Height="200"
                      AutoGenerateColumns="True"
                      IsReadOnly="True"
                      CanUserResizeRows="False"
                      CanUserAddRows="False"
                      HeadersVisibility="Column"
                      RowBackground="#F3E5F5"
                      AlternatingRowBackground="#E1BEE7"
                      BorderBrush="#BA68C8"
                      BorderThickness="1"
                      GridLinesVisibility="None"
                      FontSize="14"
                      FontFamily="Segoe UI"
                      Foreground="#4A148C"
                      SelectionMode="Single"
                      ColumnHeaderHeight="30"
                      RowHeight="28"
                      ColumnHeaderStyle="{StaticResource DataGridHeaderStyle}"
                      SelectionChanged="HistoryGrid_SelectionChanged"/>
        </Grid>
    </ScrollViewer>
</Window>
